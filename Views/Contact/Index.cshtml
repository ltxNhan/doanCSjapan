@{
    ViewData["Title"] = "Liên hệ đặt vé";
}

<div class="contact-page">

    <!-- HERO -->
    <section class="contact-hero">
        <span class="contact-badge">✈️ Travel Support</span>

        <h1>Liên hệ tư vấn đặt vé máy bay</h1>

        <p>
            Bạn muốn đến Nhật Bản để tham gia các lễ hội nổi tiếng?
            Hãy gửi thông tin chuyến đi, thời gian dự kiến và lễ hội bạn quan tâm.
            Chúng tôi sẽ hỗ trợ tư vấn lịch trình, thời điểm phù hợp và thông tin đặt vé máy bay.
        </p>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm">
            @TempData["Success"]
        </div>
    }

    <div class="row">
        <!-- FORM -->
        <div class="col-lg-7 mb-4">
            <div class="contact-form-card">
                <h3>Gửi yêu cầu tư vấn</h3>
                <p class="text-muted">
                    Điền thông tin bên dưới để được hỗ trợ tư vấn chuyến đi Nhật Bản theo mùa lễ hội.
                </p>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Họ tên</label>
                        <input type="text"
                               name="fullName"
                               class="form-control contact-input"
                               placeholder="Nhập họ tên của bạn"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email hoặc số điện thoại</label>
                        <input type="text"
                               name="email"
                               class="form-control contact-input"
                               placeholder="Nhập email hoặc số điện thoại"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Điểm khởi hành</label>
                        <input type="text"
                               name="departure"
                               class="form-control contact-input"
                               placeholder="Ví dụ: TP. Hồ Chí Minh, Hà Nội, Đà Nẵng..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thành phố muốn đến tại Nhật Bản</label>
                        <input type="text"
                               name="destination"
                               class="form-control contact-input"
                               placeholder="Ví dụ: Tokyo, Osaka, Kyoto, Sapporo..." />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày đi dự kiến</label>
                            <input type="date"
                                   name="departureDate"
                                   class="form-control contact-input" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày về dự kiến</label>
                            <input type="date"
                                   name="returnDate"
                                   class="form-control contact-input" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Lễ hội quan tâm</label>
                        <input type="text"
                               name="festivalName"
                               class="form-control contact-input"
                               placeholder="Ví dụ: Gion Matsuri, Hanami Ueno, Sapporo Snow Festival..." />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Nội dung yêu cầu</label>
                        <textarea name="message"
                                  class="form-control contact-input"
                                  rows="5"
                                  placeholder="Nhập yêu cầu tư vấn: số người đi, ngân sách dự kiến, thời gian mong muốn..."
                                  required></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger rounded-pill px-4 py-2">
                        ✈️ Gửi yêu cầu tư vấn
                    </button>
                </form>
            </div>
        </div>

        <!-- INFO -->
        <div class="col-lg-5 mb-4">
            <div class="contact-info-card h-100">
                <h3>Hỗ trợ chuyến đi lễ hội</h3>

                <div class="info-item">
                    <div class="info-icon">✈️</div>
                    <div>
                        <strong>Tư vấn vé máy bay</strong>
                        <p>Gợi ý thời điểm bay phù hợp với lịch lễ hội bạn quan tâm.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">🗓️</div>
                    <div>
                        <strong>Lịch trình theo lễ hội</strong>
                        <p>Hỗ trợ chọn thời gian đi theo mùa hoa anh đào, pháo hoa, tuyết hoặc lễ hội truyền thống.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📍</div>
                    <div>
                        <strong>Gợi ý điểm đến</strong>
                        <p>Tokyo, Kyoto, Osaka, Sapporo, Fukuoka và các thành phố có lễ hội nổi bật.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">🎌</div>
                    <div>
                        <strong>Japan Festival</strong>
                        <p>Kết nối thông tin lễ hội với nhu cầu du lịch thực tế.</p>
                    </div>
                </div>

                <div class="contact-note">
                    <h5>Lưu ý</h5>
                    <p>
                        Trang này dùng để gửi yêu cầu tư vấn. Website không bán vé trực tiếp,
                        mà hỗ trợ người dùng để lại thông tin liên hệ và nhu cầu chuyến đi.
                    </p>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .contact-page {
        padding-bottom: 50px;
    }

    .contact-hero {
        background: linear-gradient(135deg, #fff0f2, #ffffff);
        border: 1px solid #ffe0e5;
        border-radius: 32px;
        padding: 42px;
        margin-bottom: 30px;
        box-shadow: 0 14px 38px rgba(0,0,0,0.07);
    }

    .contact-badge {
        display: inline-block;
        background: white;
        color: #dc3545;
        border: 1px solid #ffd1d8;
        border-radius: 999px;
        padding: 8px 16px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .contact-hero h1 {
        font-size: 46px;
        font-weight: 900;
        margin-bottom: 14px;
        color: #222;
    }

    .contact-hero p {
        color: #666;
        font-size: 18px;
        line-height: 1.8;
        max-width: 900px;
        margin-bottom: 0;
    }

    .contact-form-card,
    .contact-info-card {
        background: white;
        border: 1px solid #eee;
        border-radius: 30px;
        padding: 30px;
        box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }

        .contact-form-card h3,
        .contact-info-card h3 {
            font-size: 28px;
            font-weight: 900;
            margin-bottom: 8px;
        }

    .form-label {
        font-weight: 700;
        color: #333;
    }

    .contact-input {
        border-radius: 16px;
        padding: 13px 16px;
        border: 1px solid #e5e5e5;
    }

        .contact-input:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.18rem rgba(220, 53, 69, 0.15);
        }

    .info-item {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 18px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .info-icon {
        width: 48px;
        height: 48px;
        background: #fff0f2;
        color: #dc3545;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .info-item strong {
        display: block;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .info-item p {
        color: #666;
        margin-bottom: 0;
    }

    .contact-note {
        background: #fff0f2;
        border: 1px solid #ffd1d8;
        border-radius: 22px;
        padding: 20px;
        margin-top: 24px;
    }

        .contact-note h5 {
            font-weight: 900;
            margin-bottom: 8px;
        }

        .contact-note p {
            color: #666;
            margin-bottom: 0;
            line-height: 1.7;
        }

    @@media (max-width: 576px) {
        .contact-hero {
            padding: 28px 22px;
        }

            .contact-hero h1 {
                font-size: 34px;
            }

        .contact-form-card,
        .contact-info-card {
            padding: 24px 20px;
        }
    }
</style>