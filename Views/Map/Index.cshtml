@model List<JapanApp.Models.Festival>

@{
    ViewData["Title"] = "Bản đồ Lễ hội";
}

<div class="premium-map-page">
    <!-- Map Container Full Bleed -->
    <div class="map-container">
        
        <!-- Floating Glass Panel -->
        <div class="glass-overlay-panel fade-in-left">
            <div class="badge-glass">🗺️ Bản đồ tương tác</div>
            <h1 class="panel-title">Khám Phá Nhật Bản</h1>
            <p class="panel-desc">Trải nghiệm vị trí của <strong>@Model.Count</strong> lễ hội truyền thống trên khắp Nhật Bản.</p>
            
            <hr class="glass-divider" />
            
            <div class="panel-features">
                <div class="feature-item">
                    <span class="feature-icon">📍</span>
                    <span>Click vào ghim để xem chi tiết</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">🔍</span>
                    <span>Zoom để xem chính xác vị trí</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">🗺️</span>
                    <span>Kết nối trực tiếp Google Maps</span>
                </div>
            </div>
            
            <a href="/Festival" class="btn-back-glass mt-4">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Về danh sách
            </a>
        </div>

        <div id="allFestivalMap"></div>
    </div>
</div>

<!-- LEAFLET -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    /* PREMIUM AESTHETIC */
    :root {
        --primary: #d90429;
        --dark: #2b2d42;
        --light: #edf2f4;
    }
    
    .premium-map-page {
        margin: -30px; /* Overcome normal-page padding */
        background: #f8f9fc;
        font-family: 'Poppins', sans-serif;
    }

    .map-container {
        position: relative;
        width: 100%;
        height: 88vh; /* Large immersive map */
        min-height: 600px;
        overflow: hidden;
    }

    #allFestivalMap {
        width: 100%;
        height: 100%;
        z-index: 1; /* Below overlay */
    }

    /* Floating Overlay Panel */
    .glass-overlay-panel {
        position: absolute;
        top: 40px;
        left: 40px;
        z-index: 1000; /* Above Leaflet map */
        width: 380px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 30px;
        padding: 35px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }

    .badge-glass {
        display: inline-block;
        background: rgba(217, 4, 41, 0.1);
        color: var(--primary);
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 15px;
        letter-spacing: 1px;
        text-transform: uppercase;
        border: 1px solid rgba(217, 4, 41, 0.2);
    }

    .panel-title {
        font-size: 34px;
        font-weight: 900;
        color: var(--dark);
        margin-bottom: 12px;
        line-height: 1.2;
    }

    .panel-desc {
        color: #4a5060;
        font-size: 15px;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .glass-divider {
        border-color: rgba(0,0,0,0.1);
        margin: 20px 0;
    }

    .panel-features {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 600;
    }

    .feature-icon {
        width: 36px;
        height: 36px;
        background: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        font-size: 16px;
    }

    .btn-back-glass {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: white;
        color: var(--dark);
        padding: 14px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        transition: 0.3s;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    .btn-back-glass:hover {
        background: var(--dark);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }

    /* Customizing Leaflet Popups */
    .leaflet-popup-content-wrapper {
        border-radius: 20px !important;
        padding: 0 !important;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2) !important;
        border: none !important;
    }
    .leaflet-popup-content {
        margin: 0 !important;
        width: auto !important;
    }
    .leaflet-popup-tip {
        box-shadow: none !important;
    }

    .custom-popup {
        padding: 24px;
        min-width: 240px;
    }
    
    .custom-popup b {
        display: block;
        font-size: 18px;
        color: var(--dark);
        margin-bottom: 5px;
        font-weight: 800;
        line-height: 1.3;
    }

    .custom-popup .loc {
        color: #666;
        font-size: 13px;
        margin-bottom: 18px;
        display: flex;
        align-items: flex-start;
        gap: 6px;
        line-height: 1.4;
    }

    .custom-popup-actions {
        display: flex;
        gap: 10px;
    }

    .popup-btn {
        flex: 1;
        text-align: center;
        padding: 10px 0;
        border-radius: 12px;
        text-decoration: none !important;
        font-weight: 700;
        font-size: 13px;
        transition: 0.2s;
        color: white !important;
    }

    .popup-btn-detail { background: var(--primary); }
    .popup-btn-detail:hover { background: #b00320; }
    
    .popup-btn-map { background: #1a73e8; }
    .popup-btn-map:hover { background: #1557b0; }

    /* Animations */
    .fade-in-left {
        animation: fadeInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateX(-30px);
    }

    @@keyframes fadeInLeft {
        to { opacity: 1; transform: translateX(0); }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .premium-map-page { margin: -15px; }
        .map-container { height: calc(100vh - 60px); }
        .glass-overlay-panel {
            top: auto;
            bottom: 25px;
            left: 20px;
            right: 20px;
            width: auto;
            padding: 25px;
            border-radius: 24px;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.1);
        }
        .panel-features { display: none; } /* Hide on mobile */
        .panel-title { font-size: 26px; }
        .glass-divider { margin: 15px 0; }
        .btn-back-glass { padding: 12px; }
        .leaflet-control-zoom { display: none; } /* Hide zoom controls on mobile, use pinch */
    }
</style>

<script>
    const festivals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Select(f => new
        {
            id = f.FestivalID,
            name = f.Name,
            location = f.LocationName,
            latitude = f.Latitude,
            longitude = f.Longitude
        })
    ));

    // Initialize Map with zoom control disabled initially
    const map = L.map('allFestivalMap', {
        zoomControl: false 
    }).setView([36.2048, 138.2529], 6);

    // Add Zoom control to bottom right so it doesn't overlap with the panel
    L.control.zoom({
        position: 'bottomright'
    }).addTo(map);

    // Use CartoDB Positron for a much cleaner, premium map aesthetic than standard OSM
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
        subdomains: 'abcd',
        maxZoom: 20
    }).addTo(map);

    // Custom Marker Icon (Red to match branding)
    const customIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
    });

    festivals.forEach(f => {
        // Skip festivals without valid coordinates
        if(f.latitude === 0 && f.longitude === 0) return;

        const popupHtml = `
            <div class="custom-popup">
                <b>${f.name}</b>
                <div class="loc">📍 <span>${f.location}</span></div>
                <div class="custom-popup-actions">
                    <a href="/Festival/Details/${f.id}" class="popup-btn popup-btn-detail">Chi tiết</a>
                    <a href="https://www.google.com/maps/search/?api=1&query=${f.latitude},${f.longitude}" target="_blank" class="popup-btn popup-btn-map">Google Maps</a>
                </div>
            </div>
        `;

        const marker = L.marker([f.latitude, f.longitude], {icon: customIcon})
            .addTo(map)
            .bindPopup(popupHtml);
            
        marker.on('click', function(e) {
            // Khi click vào marker, bản đồ sẽ tự động zoom lại gần vị trí đó (zoom level 15)
            map.flyTo(e.latlng, 15, {
                animate: true,
                duration: 1.5
            });
        });
    });
</script>