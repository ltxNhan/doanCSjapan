@model List<JapanApp.Models.QuizQuestion>

@{
    ViewData["Title"] = "Trắc nghiệm Lễ hội";
}

<div class="premium-quiz-page">
    <!-- Background Elements -->
    <div class="bg-glow shape-1"></div>
    <div class="bg-glow shape-2"></div>
    <div class="bg-grid"></div>

    <div class="quiz-container">
        
        <div class="quiz-header fade-in-up">
            <div class="badge-smart">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                Trải Nghiệm Thông Minh
            </div>
            <h1 class="quiz-title">Khám Phá Lễ Hội Của Bạn</h1>
            <p class="quiz-subtitle">Trí tuệ nhân tạo sẽ phân tích sở thích để tìm ra trải nghiệm văn hóa Nhật Bản phù hợp nhất với bạn.</p>
        </div>

        <div class="quiz-card glass-panel fade-in-up" style="animation-delay: 0.1s;">
            
            <div class="quiz-progress-section">
                <div class="d-flex justify-content-between align-items-end mb-2">
                    <span class="step-indicator">Câu hỏi <span id="currentStepNum" class="current-num">1</span><span class="total-num">/@Model.Count</span></span>
                    <span class="percentage-indicator" id="progressPct">0%</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" id="progressFill" style="width: @(100.0 / Model.Count)%"></div>
                </div>
            </div>

            <form action="/Quiz/Submit" method="post" id="quizForm">
                <div class="questions-viewport">
                    <div class="questions-track" id="questionsTrack">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var q = Model[i];
                            <div class="quiz-step" id="step-@i">
                                <h2 class="question-text">@q.QuestionText</h2>
                                
                                <div class="answers-grid">
                                    @{ char letter = 'A'; }
                                    @foreach (var ans in q.Answers)
                                    {
                                        <label class="answer-card">
                                            <input type="radio" name="answerIds" value="@ans.AnswerID" class="answer-radio" required onchange="handleAnswerSelect(@i)" />
                                            <div class="answer-content">
                                                <div class="answer-letter">@letter</div>
                                                <span class="answer-text">@ans.AnswerText</span>
                                                <div class="check-circle">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                </div>
                                            </div>
                                        </label>
                                        letter++;
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="quiz-footer mt-5">
                    <button type="button" class="btn-smart btn-back" id="btnPrev" style="opacity: 0; pointer-events: none;" onclick="prevStep()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                        Quay lại
                    </button>
                    
                    <button type="button" class="btn-smart btn-next ms-auto" id="btnNext" onclick="nextStep()" disabled>
                        Tiếp tục
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ms-2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                    
                    <button type="button" class="btn-smart btn-submit ms-auto" id="btnSubmit" style="display: none;" onclick="processAI()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        Phân Tích Bằng AI
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Modern AI Processing Overlay -->
<div id="aiOverlay" class="ai-overlay">
    <div class="ai-particles"></div>
    <div class="ai-modal glass-panel">
        <div class="ai-brain-container">
            <div class="brain-ring outer"></div>
            <div class="brain-ring inner"></div>
            <div class="brain-core">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            </div>
        </div>
        <h2 class="ai-title" id="aiStatusText">Khởi động AI Engine...</h2>
        
        <div class="ai-progress-container mt-4">
            <div class="ai-progress-bar" id="aiProgress"></div>
        </div>
        <p class="ai-subtitle mt-2" id="aiSubStatus">Đang thiết lập kết nối</p>
        
        <div class="ai-logs mt-3" id="aiLogs">
            <!-- Logs appended via JS -->
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #E60012;
        --primary-light: #ff1a2e;
        --dark: #0f1115;
        --dark-card: #1a1d24;
        --text-main: #f8f9fc;
        --text-muted: #8d93a5;
        --border-color: rgba(255,255,255,0.08);
        --accent: #FFD700;
    }

    body {
        background-color: var(--dark);
        color: var(--text-main);
    }

    .premium-quiz-page {
        min-height: 100vh;
        margin: -30px;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', 'Poppins', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        background: #0a0a0f;
    }

    /* Background Effects */
    .bg-grid {
        position: absolute; inset: 0;
        background-image: 
            linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 50px 50px;
        z-index: 0;
    }

    .bg-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.15;
        z-index: 0;
        animation: float 10s infinite alternate;
    }

    .shape-1 {
        background: var(--primary);
        width: 500px; height: 500px;
        top: -100px; right: -100px;
    }

    .shape-2 {
        background: #4a00e0;
        width: 400px; height: 400px;
        bottom: -50px; left: -100px;
        animation-delay: -5s;
    }

    @@keyframes float {
        0% { transform: translate(0, 0); }
        100% { transform: translate(30px, 50px); }
    }

    .quiz-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 760px;
    }

    /* Header */
    .quiz-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .badge-smart {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(230, 0, 18, 0.1);
        border: 1px solid rgba(230, 0, 18, 0.2);
        color: var(--primary-light);
        padding: 8px 16px; border-radius: 999px;
        font-size: 13px; font-weight: 600;
        margin-bottom: 16px;
        text-transform: uppercase; letter-spacing: 1px;
    }

    .quiz-title {
        font-size: 38px; font-weight: 800;
        margin-bottom: 12px;
        background: linear-gradient(135deg, #fff, #aaa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .quiz-subtitle {
        color: var(--text-muted); font-size: 16px;
        max-width: 500px; margin: 0 auto; line-height: 1.6;
    }

    /* Card & Glassmorphism */
    .glass-panel {
        background: rgba(26, 29, 36, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }

    .quiz-card {
        padding: 40px;
    }

    /* Progress */
    .quiz-progress-section {
        margin-bottom: 30px;
    }

    .step-indicator {
        font-size: 14px; font-weight: 600; color: var(--text-muted);
    }
    .step-indicator .current-num {
        color: white; font-size: 16px; font-weight: 700;
    }
    
    .percentage-indicator {
        font-size: 13px; font-weight: 700; color: var(--primary);
    }

    .progress-track {
        height: 6px; background: rgba(255,255,255,0.05);
        border-radius: 999px; overflow: hidden;
    }

    .progress-fill {
        height: 100%; background: var(--primary);
        border-radius: 999px;
        transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
        box-shadow: 0 0 10px rgba(230,0,18,0.5);
    }

    /* Questions Carousel */
    .questions-viewport {
        overflow: hidden;
        margin: 0 -10px; padding: 0 10px;
    }

    .questions-track {
        display: flex;
        transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
        width: 100%;
    }

    .quiz-step {
        width: 100%; flex-shrink: 0;
        opacity: 0; transition: opacity 0.5s;
        pointer-events: none;
    }
    .quiz-step.active-step {
        opacity: 1; pointer-events: auto;
    }

    .question-text {
        font-size: 22px; font-weight: 700; color: white;
        margin-bottom: 30px; line-height: 1.5;
    }

    /* Answers Grid */
    .answers-grid {
        display: flex; flex-direction: column; gap: 12px;
    }

    .answer-card {
        display: block; cursor: pointer; user-select: none;
    }

    .answer-radio { display: none; }

    .answer-content {
        display: flex; align-items: center;
        padding: 16px 20px;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        position: relative; overflow: hidden;
    }

    .answer-content::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(90deg, rgba(230,0,18,0.1), transparent);
        opacity: 0; transition: 0.3s;
    }

    .answer-letter {
        width: 32px; height: 32px; border-radius: 8px;
        background: rgba(255,255,255,0.1);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 14px; color: var(--text-muted);
        margin-right: 15px; transition: 0.3s;
    }

    .answer-text {
        font-size: 16px; font-weight: 500; color: var(--text-main);
        flex-grow: 1; transition: 0.3s;
    }

    .check-circle {
        width: 24px; height: 24px; border-radius: 50%;
        background: var(--primary);
        display: flex; align-items: center; justify-content: center;
        transform: scale(0); opacity: 0; transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* Hover & Checked States */
    .answer-card:hover .answer-content {
        background: rgba(255,255,255,0.06);
        border-color: rgba(255,255,255,0.15);
        transform: translateX(4px);
    }

    .answer-radio:checked + .answer-content {
        border-color: var(--primary);
        background: rgba(230,0,18,0.05);
        box-shadow: 0 8px 20px rgba(230,0,18,0.1);
    }
    
    .answer-radio:checked + .answer-content::before { opacity: 1; }

    .answer-radio:checked + .answer-content .answer-letter {
        background: var(--primary); color: white;
    }

    .answer-radio:checked + .answer-content .check-circle {
        transform: scale(1); opacity: 1;
    }

    /* Navigation Buttons */
    .quiz-footer {
        display: flex; align-items: center; justify-content: space-between;
    }

    .btn-smart {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 14px 28px; border-radius: 12px;
        font-weight: 600; font-size: 15px; border: none;
        cursor: pointer; transition: all 0.3s;
    }

    .btn-next {
        background: white; color: var(--dark);
    }
    .btn-next:hover:not(:disabled) {
        transform: translateY(-2px); box-shadow: 0 10px 20px rgba(255,255,255,0.1);
    }
    .btn-next:disabled {
        opacity: 0.3; cursor: not-allowed;
    }

    .btn-back {
        background: transparent; color: var(--text-muted);
        padding: 14px 0;
    }
    .btn-back:hover {
        color: white;
    }

    .btn-submit {
        background: var(--primary); color: white;
        box-shadow: 0 0 20px rgba(230,0,18,0.4);
    }
    .btn-submit:hover {
        background: var(--primary-light);
        box-shadow: 0 0 30px rgba(230,0,18,0.6);
        transform: translateY(-2px);
    }

    /* Animations */
    .fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        opacity: 0; transform: translateY(20px);
    }
    @@keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }

    /* Modern AI Overlay */
    .ai-overlay {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(10, 10, 15, 0.9);
        backdrop-filter: blur(10px);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; pointer-events: none; transition: opacity 0.5s;
    }
    .ai-overlay.active {
        opacity: 1; pointer-events: auto;
    }

    .ai-modal {
        width: 100%; max-width: 450px; padding: 50px 40px;
        text-align: center; border: 1px solid rgba(230,0,18,0.2);
        box-shadow: 0 0 50px rgba(230,0,18,0.1);
        transform: scale(0.9); transition: 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .ai-overlay.active .ai-modal { transform: scale(1); }

    .ai-brain-container {
        position: relative; width: 100px; height: 100px;
        margin: 0 auto 30px; display: flex; align-items: center; justify-content: center;
    }

    .brain-core {
        width: 60px; height: 60px; background: var(--primary);
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 30px var(--primary);
        animation: pulse 1.5s infinite alternate;
        position: relative; z-index: 2;
    }

    .brain-ring {
        position: absolute; inset: 0; border-radius: 50%;
        border: 2px solid transparent;
    }
    .brain-ring.inner {
        inset: 10px; border-top-color: var(--primary); border-bottom-color: var(--primary);
        animation: spin 2s linear infinite;
    }
    .brain-ring.outer {
        border-left-color: rgba(255,255,255,0.2); border-right-color: rgba(255,255,255,0.2);
        animation: spin 4s linear infinite reverse;
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 20px var(--primary); }
        100% { transform: scale(1.05); box-shadow: 0 0 40px var(--primary); }
    }
    @@keyframes spin { 100% { transform: rotate(360deg); } }

    .ai-title { font-size: 22px; font-weight: 700; color: white; margin-bottom: 8px; }
    .ai-subtitle { font-size: 14px; color: var(--text-muted); }

    .ai-progress-container {
        height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden;
    }
    .ai-progress-bar {
        height: 100%; width: 0%; background: var(--primary);
        transition: width 0.3s;
    }

    .ai-logs {
        text-align: left; background: rgba(0,0,0,0.3);
        padding: 12px; border-radius: 8px; font-family: monospace;
        font-size: 11px; color: #aaa; height: 80px; overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
    }
    .log-line { margin-bottom: 4px; opacity: 0; animation: fadeInLog 0.3s forwards; }
    .log-line.success { color: #4ade80; }
    @@keyframes fadeInLog { to { opacity: 1; transform: translateY(0); } }

    @@media (max-width: 768px) {
        .quiz-card { padding: 25px; }
        .quiz-title { font-size: 28px; }
        .question-text { font-size: 18px; }
    }
</style>

<script>
    const totalSteps = @Model.Count;
    let currentStep = 0;
    const track = document.getElementById('questionsTrack');

    function updateUI() {
        // Move track
        track.style.transform = `translateX(-${currentStep * 100}%)`;

        // Update active class for opacity
        for (let i = 0; i < totalSteps; i++) {
            const stepEl = document.getElementById(`step-${i}`);
            if(i === currentStep) {
                stepEl.classList.add('active-step');
            } else {
                stepEl.classList.remove('active-step');
            }
        }

        // Update Progress
        document.getElementById('currentStepNum').innerText = currentStep + 1;
        
        let pct = ((currentStep + 1) / totalSteps) * 100;
        document.getElementById('progressFill').style.width = `${pct}%`;
        document.getElementById('progressPct').innerText = `${Math.round(pct)}%`;

        // Update Buttons
        const btnPrev = document.getElementById('btnPrev');
        if (currentStep > 0) {
            btnPrev.style.visibility = 'visible';
            btnPrev.style.opacity = '1';
            btnPrev.style.pointerEvents = 'auto';
        } else {
            btnPrev.style.visibility = 'hidden';
            btnPrev.style.opacity = '0';
            btnPrev.style.pointerEvents = 'none';
        }
        
        if (currentStep === totalSteps - 1) {
            document.getElementById('btnNext').style.display = 'none';
            document.getElementById('btnSubmit').style.display = 'inline-flex';
        } else {
            document.getElementById('btnNext').style.display = 'inline-flex';
            document.getElementById('btnSubmit').style.display = 'none';
        }

        checkAnswerSelected();
    }

    function handleAnswerSelect(stepIndex) {
        if(stepIndex === currentStep) {
            checkAnswerSelected();
            // Optional: Auto-advance after a short delay
            if(currentStep < totalSteps - 1) {
                setTimeout(() => {
                    nextStep();
                }, 600);
            }
        }
    }

    function checkAnswerSelected() {
        const stepDiv = document.getElementById(`step-${currentStep}`);
        const radios = stepDiv.querySelectorAll('input[type="radio"]');
        let isChecked = Array.from(radios).some(r => r.checked);
        
        document.getElementById('btnNext').disabled = !isChecked;
        if(currentStep === totalSteps - 1) {
            document.getElementById('btnSubmit').disabled = !isChecked;
        }
    }

    function nextStep() {
        if (currentStep < totalSteps - 1) {
            currentStep++;
            updateUI();
        }
    }

    function prevStep() {
        if (currentStep > 0) {
            currentStep--;
            updateUI();
        }
    }

    // AI Processing Function
    function processAI() {
        const overlay = document.getElementById('aiOverlay');
        const statusText = document.getElementById('aiStatusText');
        const subStatus = document.getElementById('aiSubStatus');
        const progressBar = document.getElementById('aiProgress');
        const logsContainer = document.getElementById('aiLogs');
        
        overlay.classList.add('active');

        const logs = [
            "> Khởi tạo mô hình phân tích...",
            "> Đang thu thập dữ liệu câu trả lời [OK]",
            "> Đang quét cơ sở dữ liệu 100+ Lễ hội...",
            "> Khớp sở thích: Văn hóa, Thời gian, Hoạt động...",
            "> Áp dụng thuật toán cá nhân hóa...",
            "> Đang tạo danh sách đề xuất tối ưu [Hoàn thành]"
        ];

        let logIndex = 0;
        let progress = 0;

        const interval = setInterval(() => {
            // Update Progress
            progress += 5;
            progressBar.style.width = `${progress}%`;

            // Update Logs & Status
            if (progress % 15 === 0 && logIndex < logs.length) {
                const logEl = document.createElement('div');
                logEl.className = 'log-line ' + (logIndex === logs.length - 1 ? 'success' : '');
                logEl.innerText = logs[logIndex];
                logsContainer.appendChild(logEl);
                logsContainer.scrollTop = logsContainer.scrollHeight;

                if(logIndex === 2) {
                    statusText.innerText = 'Đang phân tích dữ liệu...';
                    subStatus.innerText = 'Chạy thuật toán so khớp đặc điểm';
                } else if(logIndex === 4) {
                    statusText.innerText = 'Sắp hoàn thành...';
                    subStatus.innerText = 'Chuẩn bị kết quả cuối cùng';
                }

                logIndex++;
            }

            if (progress >= 100) {
                clearInterval(interval);
                statusText.innerText = 'Hoàn tất!';
                subStatus.innerText = 'Chuyển hướng đến kết quả của bạn';
                
                setTimeout(() => {
                    document.getElementById('quizForm').submit();
                }, 800);
            }
        }, 150); // 150 * 20 = 3000ms = 3 seconds total
    }

    // Call updateUI once to init
    updateUI();
</script>
