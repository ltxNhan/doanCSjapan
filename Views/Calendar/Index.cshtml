@model List<JapanApp.Models.Festival>

@{
    ViewData["Title"] = "Lịch Lễ Hội";

    var festivals = Model
        .Select(f => new
        {
            Festival = f,
            Start = GetDisplayStartDate(f.StartDate, f.EndDate),
            End = GetDisplayEndDate(f.StartDate, f.EndDate)
        })
        .OrderBy(x => x.Start)
        .ToList();

    var upcoming = festivals.Take(3).ToList();

    var groups = festivals
        .GroupBy(x => new { x.Start.Year, x.Start.Month })
        .OrderBy(g => g.Key.Year)
        .ThenBy(g => g.Key.Month);
}

<div class="premium-calendar-page">

    <!-- HERO SECTION -->
    <section class="calendar-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 hero-text fade-up-anim">
                    <span class="glass-badge mb-3">📅 Timeline Chuyên Nghiệp</span>
                    <h1 class="hero-title">Lịch Trình<br/><span class="text-primary-accent">Lễ Hội Nhật Bản</span></h1>
                    <p class="hero-desc">
                        Không bỏ lỡ bất kỳ khoảnh khắc văn hóa nào. Lịch lễ hội được tự động đồng bộ theo thời gian thực, giúp bạn dễ dàng theo dõi và lên kế hoạch cho chuyến đi của mình.
                    </p>
                    <div class="hero-actions mt-4">
                        <a href="#upcoming" class="btn-premium btn-solid-primary">Khám phá ngay <span class="arrow">↓</span></a>
                        <a href="/Map" class="btn-premium btn-outline-glass">🗺️ Mở bản đồ</a>
                    </div>
                </div>
                <div class="col-lg-6 hero-visual fade-up-anim" style="animation-delay: 0.2s;">
                    <div class="calendar-3d-wrapper">
                        <div class="calendar-card shadow-lg">
                            <div class="cal-top">
                                <div class="cal-dots"><span></span><span></span><span></span></div>
                            </div>
                            <div class="cal-body">
                                <div class="cal-month">@DateTime.Today.ToString("MMMM")</div>
                                <div class="cal-day">@DateTime.Today.ToString("dd")</div>
                                <div class="cal-year">@DateTime.Today.Year</div>
                            </div>
                        </div>
                        <div class="cal-decoration circle-1"></div>
                        <div class="cal-decoration circle-2"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-bg-shape"></div>
    </section>

    <!-- UPCOMING EVENTS -->
    <section id="upcoming" class="upcoming-section section-padding bg-light-pattern">
        <div class="container">
            <div class="section-header text-center fade-up-anim">
                <span class="section-accent">GẦN NHẤT</span>
                <h2 class="section-title">Lễ Hội Sắp Diễn Ra</h2>
                <p class="section-desc mx-auto">Chuẩn bị hành trang cho những sự kiện văn hóa hoành tráng sắp bắt đầu.</p>
            </div>

            <div class="row g-4 mt-4">
                @for(int i = 0; i < upcoming.Count; i++)
                {
                    var item = upcoming[i];
                    <div class="col-lg-4 col-md-6 fade-up-anim" style="animation-delay: @(i * 0.1)s;">
                        <div class="upcoming-premium-card hover-lift">
                            <div class="card-img-container">
                                <img src="@Url.Content("~/images/" + GetImageName(item.Festival.Name))" 
                                     onerror="this.src='@Url.Content("~/images/default.jpg")';" 
                                     alt="@item.Festival.Name" />
                                <div class="date-floating-badge shadow">
                                    <span class="d-day">@item.Start.ToString("dd")</span>
                                    <span class="d-month">Thg @item.Start.ToString("MM")</span>
                                </div>
                            </div>
                            <div class="card-content">
                                <h3>@item.Festival.Name</h3>
                                <div class="meta-row">
                                    <span class="meta-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> @item.Festival.LocationName</span>
                                    <span class="meta-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> @FormatDateRange(item.Start, item.End)</span>
                                </div>
                                <a href="/Festival/Details/@item.Festival.FestivalID" class="btn-explore-link mt-3">
                                    Xem chi tiết <span class="arrow">→</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- TIMELINE SECTION -->
    <section class="timeline-section section-padding bg-white">
        <div class="container">
            <div class="section-header fade-up-anim">
                <span class="section-accent">TOÀN BỘ LỊCH TRÌNH</span>
                <h2 class="section-title">Danh Sách Theo Tháng</h2>
            </div>

            <div class="timeline-wrapper mt-5">
                @foreach (var group in groups)
                {
                    <div class="timeline-month-group fade-up-anim">
                        <div class="month-header-sticky shadow-sm">
                            <div class="d-flex align-items-center gap-3">
                                <div class="month-icon">📅</div>
                                <div>
                                    <h3 class="month-title-text">Tháng @group.Key.Month, @group.Key.Year</h3>
                                    <span class="month-count">@group.Count() sự kiện</span>
                                </div>
                            </div>
                        </div>

                        <div class="timeline-events-list">
                            @foreach (var item in group)
                            {
                                <div class="timeline-event-row">
                                    <!-- Date Col -->
                                    <div class="event-date-col">
                                        <div class="date-box shadow-sm">
                                            <strong>@item.Start.ToString("dd")</strong>
                                            <span>Thg @item.Start.ToString("MM")</span>
                                        </div>
                                    </div>

                                    <!-- Content Col -->
                                    <div class="event-content-col">
                                        <div class="event-card-glass hover-scale">
                                            <div class="event-thumb d-none d-md-block">
                                                <img src="@Url.Content("~/images/" + GetImageName(item.Festival.Name))" 
                                                     onerror="this.src='@Url.Content("~/images/default.jpg")';" 
                                                     alt="@item.Festival.Name" />
                                            </div>
                                            <div class="event-details">
                                                <h4>@item.Festival.Name</h4>
                                                <div class="event-meta">
                                                    <span class="meta-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> @item.Festival.LocationName</span>
                                                    <span class="meta-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> @FormatDateRange(item.Start, item.End)</span>
                                                    @if(item.Festival.Season != null)
                                                    {
                                                        <span class="meta-pill text-season">🌸 @item.Festival.Season.SeasonName</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="event-action">
                                                <a href="/Festival/Details/@item.Festival.FestivalID" class="btn-icon-round shadow-sm" title="Xem chi tiết">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

</div>

<style>
    /* PREMIUM AESTHETIC - CALENDAR PAGE */
    :root {
        --primary: #d90429;
        --primary-light: #ef233c;
        --dark: #1a1a24;
        --gray: #8d93a5;
        --light: #f8f9fc;
        --white: #ffffff;
    }

    .premium-calendar-page {
        margin: -30px; /* Overcome _Layout padding */
        font-family: 'Poppins', sans-serif;
        background: var(--light);
        overflow-x: hidden;
    }

    .section-padding { padding: 80px 0; }
    .bg-light-pattern { background-color: var(--light); }
    .bg-white { background-color: var(--white); }

    .section-accent {
        display: inline-block;
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 38px;
        font-weight: 800;
        color: var(--dark);
        margin-bottom: 20px;
        line-height: 1.2;
    }

    .section-desc {
        font-size: 17px;
        color: #555;
        line-height: 1.6;
        max-width: 600px;
    }

    /* BUTTONS */
    .btn-premium {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 16px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-solid-primary {
        background: var(--primary);
        color: white;
        box-shadow: 0 10px 25px rgba(217, 4, 41, 0.25);
    }
    .btn-solid-primary:hover {
        background: var(--primary-light);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(217, 4, 41, 0.35);
    }
    .btn-solid-primary .arrow { transition: 0.3s; display: inline-block; margin-left: 8px;}
    .btn-solid-primary:hover .arrow { transform: translateY(3px); }

    .btn-outline-glass {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        color: var(--dark);
        border: 1px solid rgba(0, 0, 0, 0.1);
    }
    .btn-outline-glass:hover {
        background: white;
        color: var(--dark);
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    /* HERO SECTION */
    .calendar-hero {
        position: relative;
        padding: 120px 0;
        background: linear-gradient(135deg, #ffeef0 0%, #f8f9fc 100%);
        overflow: hidden;
    }

    .hero-bg-shape {
        position: absolute;
        top: -10%; right: -5%;
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(217,4,41,0.05) 0%, rgba(217,4,41,0) 70%);
        border-radius: 50%;
        z-index: 0;
    }

    .glass-badge {
        display: inline-block;
        background: white;
        border: 1px solid rgba(217,4,41,0.2);
        color: var(--primary);
        padding: 8px 20px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 1px;
        box-shadow: 0 5px 15px rgba(217,4,41,0.08);
    }

    .hero-title {
        font-size: 56px;
        font-weight: 900;
        color: var(--dark);
        line-height: 1.15;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
    }
    .text-primary-accent { color: var(--primary); }

    .hero-desc {
        font-size: 18px;
        color: #555;
        line-height: 1.7;
        position: relative;
        z-index: 2;
    }

    .hero-actions { position: relative; z-index: 2; display: flex; gap: 15px; flex-wrap: wrap; }

    /* 3D Calendar Graphic */
    .calendar-3d-wrapper {
        position: relative;
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
        perspective: 1000px;
    }

    .calendar-card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        transform: rotateY(-15deg) rotateX(10deg);
        box-shadow: 20px 30px 60px rgba(0,0,0,0.1), -10px -10px 30px rgba(255,255,255,0.8);
        border: 1px solid rgba(255,255,255,0.5);
        animation: float 6s ease-in-out infinite;
        position: relative;
        z-index: 2;
    }

    @@keyframes float {
        0% { transform: rotateY(-15deg) rotateX(10deg) translateY(0px); }
        50% { transform: rotateY(-10deg) rotateX(5deg) translateY(-20px); }
        100% { transform: rotateY(-15deg) rotateX(10deg) translateY(0px); }
    }

    .cal-top {
        background: linear-gradient(135deg, var(--primary), #ff4d6d);
        height: 70px;
        display: flex; align-items: center; padding: 0 30px;
    }
    .cal-dots { display: flex; gap: 8px; }
    .cal-dots span { width: 12px; height: 12px; background: white; border-radius: 50%; opacity: 0.8; }

    .cal-body { padding: 40px 30px; text-align: center; }
    .cal-month { color: var(--primary); font-weight: 800; text-transform: uppercase; letter-spacing: 2px; font-size: 18px; }
    .cal-day { font-size: 90px; font-weight: 900; line-height: 1; color: var(--dark); margin: 10px 0; }
    .cal-year { color: var(--gray); font-weight: 700; font-size: 20px; }

    .cal-decoration {
        position: absolute; border-radius: 50%; z-index: 1;
        background: linear-gradient(135deg, var(--primary), #ff4d6d);
        opacity: 0.15;
    }
    .circle-1 { width: 150px; height: 150px; top: -30px; right: -30px; animation: float 5s infinite reverse; }
    .circle-2 { width: 100px; height: 100px; bottom: -20px; left: -20px; animation: float 7s infinite; }


    /* UPCOMING EVENTS */
    .upcoming-premium-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .hover-lift:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.08);
    }

    .card-img-container {
        position: relative;
        height: 220px;
        overflow: hidden;
    }
    .card-img-container img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 0.7s;
    }
    .hover-lift:hover .card-img-container img { transform: scale(1.08); }

    .date-floating-badge {
        position: absolute;
        bottom: -20px; right: 25px;
        background: white;
        border-radius: 16px;
        width: 70px; height: 75px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        border: 2px solid #f8f9fc;
        z-index: 2;
    }
    .d-day { font-size: 24px; font-weight: 900; color: var(--primary); line-height: 1; }
    .d-month { font-size: 12px; font-weight: 700; color: var(--gray); text-transform: uppercase; margin-top: 2px; }

    .card-content { padding: 35px 25px 25px; flex-grow: 1; display: flex; flex-direction: column; }
    .card-content h3 { font-size: 22px; font-weight: 800; color: var(--dark); margin-bottom: 15px; }

    .meta-row { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; flex-grow: 1; }
    .meta-item { display: flex; align-items: center; gap: 8px; color: #666; font-size: 14px; }

    .btn-explore-link {
        color: var(--primary); font-weight: 700; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px; font-size: 15px;
    }
    .btn-explore-link .arrow { transition: 0.3s; }
    .btn-explore-link:hover .arrow { transform: translateX(5px); }

    /* TIMELINE SECTION */
    .timeline-wrapper {
        position: relative;
        max-width: 900px;
        margin: 0 auto;
    }

    /* Vertical line */
    .timeline-wrapper::before {
        content: '';
        position: absolute;
        top: 0; bottom: 0; left: 40px;
        width: 3px;
        background: #f1f3f5;
        border-radius: 3px;
    }

    .timeline-month-group {
        position: relative;
        margin-bottom: 60px;
    }

    .month-header-sticky {
        position: sticky;
        top: 80px; /* Under navbar */
        background: white;
        border-radius: 20px;
        padding: 15px 25px;
        margin-bottom: 25px;
        z-index: 10;
        border: 1px solid rgba(0,0,0,0.04);
        display: inline-block;
        margin-left: 80px;
    }

    .month-icon {
        width: 45px; height: 45px;
        background: #fff0f2;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
    }

    .month-title-text { font-size: 20px; font-weight: 800; color: var(--dark); margin: 0; }
    .month-count { font-size: 13px; color: var(--primary); font-weight: 700; background: #fff0f2; padding: 2px 10px; border-radius: 999px;}

    .timeline-events-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .timeline-event-row {
        display: flex;
        align-items: stretch;
        gap: 20px;
        position: relative;
    }

    /* Dot on timeline */
    .timeline-event-row::before {
        content: '';
        position: absolute;
        top: 30px; left: 35px;
        width: 14px; height: 14px;
        background: var(--primary);
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 0 0 4px #fff0f2;
        z-index: 2;
    }

    .event-date-col {
        width: 100px;
        flex-shrink: 0;
        display: flex;
        justify-content: flex-end;
        padding-right: 20px;
    }

    .date-box {
        background: white;
        border-radius: 16px;
        padding: 12px 15px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        height: max-content;
        border: 1px solid #f1f3f5;
        width: 65px;
    }
    .date-box strong { font-size: 22px; font-weight: 900; color: var(--primary); line-height: 1; }
    .date-box span { font-size: 12px; font-weight: 700; color: var(--gray); text-transform: uppercase; margin-top: 2px; }

    .event-content-col {
        flex-grow: 1;
    }

    .event-card-glass {
        background: white;
        border-radius: 20px;
        padding: 20px;
        display: flex;
        gap: 20px;
        align-items: center;
        border: 1px solid rgba(0,0,0,0.04);
        box-shadow: 0 10px 25px rgba(0,0,0,0.02);
        transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hover-scale:hover {
        transform: translateX(10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.06);
        border-color: rgba(217,4,41,0.1);
    }

    .event-thumb {
        width: 120px; height: 90px;
        border-radius: 14px;
        overflow: hidden;
        flex-shrink: 0;
    }
    .event-thumb img { width: 100%; height: 100%; object-fit: cover; }

    .event-details { flex-grow: 1; }
    .event-details h4 { font-size: 18px; font-weight: 800; color: var(--dark); margin-bottom: 10px; }
    
    .event-meta { display: flex; flex-wrap: wrap; gap: 10px; }
    .meta-pill {
        background: #f8f9fc;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        color: #555;
        display: flex; align-items: center; gap: 6px;
    }
    .meta-pill.text-season { background: #fff0f2; color: var(--primary); }

    .event-action { flex-shrink: 0; padding-left: 10px; }
    
    .btn-icon-round {
        width: 45px; height: 45px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        display: flex; align-items: center; justify-content: center;
        transition: 0.3s;
    }
    .btn-icon-round:hover { background: var(--primary-light); color: white; transform: scale(1.1); }

    /* ANIMATIONS */
    .fade-up-anim {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(30px);
    }
    @@keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .hero-title { font-size: 46px; }
        .calendar-3d-wrapper { max-width: 320px; }
    }

    @@media (max-width: 768px) {
        .premium-calendar-page { margin: -15px; }
        .hero-title { font-size: 38px; }
        .hero-text { text-align: center; }
        .hero-actions { justify-content: center; }
        
        .timeline-wrapper::before { left: 20px; }
        .month-header-sticky { margin-left: 40px; padding: 12px 20px; }
        .timeline-event-row { gap: 10px; }
        .timeline-event-row::before { left: 14px; top: 25px; }
        .event-date-col { width: 60px; padding-right: 10px; }
        .date-box { width: 50px; padding: 10px; }
        .date-box strong { font-size: 18px; }
        .date-box span { font-size: 10px; }
        
        .event-card-glass { flex-direction: column; align-items: flex-start; gap: 15px; }
        .event-action { align-self: flex-end; width: 100%; }
        .btn-icon-round { width: 100%; border-radius: 12px; height: 40px; }
    }
</style>

@functions {
    public DateTime GetDisplayStartDate(DateTime startDate, DateTime endDate)
    {
        var today = DateTime.Today;
        var displayStart = new DateTime(today.Year, startDate.Month, startDate.Day);
        var displayEnd = new DateTime(today.Year, endDate.Month, endDate.Day);
        if (displayEnd < today) { displayStart = new DateTime(today.Year + 1, startDate.Month, startDate.Day); }
        return displayStart;
    }

    public DateTime GetDisplayEndDate(DateTime startDate, DateTime endDate)
    {
        var today = DateTime.Today;
        var displayEnd = new DateTime(today.Year, endDate.Month, endDate.Day);
        if (displayEnd < today) { displayEnd = new DateTime(today.Year + 1, endDate.Month, endDate.Day); }
        return displayEnd;
    }

    public string FormatDateRange(DateTime start, DateTime end)
    {
        if (start.Date == end.Date) return start.ToString("dd/MM/yyyy");
        return $"{start:dd/MM} - {end:dd/MM/yyyy}";
    }

    public string GetImageName(string name)
    {
        name = (name ?? "").ToLower();
        if (name.Contains("hanami")) return "tokyo-hanami.jpg";
        if (name.Contains("sumida")) return "tokyo-sumida.jpg";
        if (name.Contains("kanda")) return "tokyo-kanda.jpg";
        if (name.Contains("asakusa")) return "tokyo-asakusa.jpg";
        if (name.Contains("gion")) return "kyoto-gion.jpg";
