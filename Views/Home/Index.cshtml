@{
    ViewData["Title"] = "Trang chủ";
}

<div class="premium-home">
    <!-- HERO SECTION -->
    <section class="hero-section">
        <video autoplay muted loop playsinline class="hero-video">
            <source src="@Url.Content("~/videos/japan-hero.mp4")" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
        
        <div class="hero-content-wrapper">
            <div class="hero-text-content fade-up-anim">
                <div class="glass-badge mb-4">🎌 Japan Festival Platform</div>
                <h1 class="hero-main-title">
                    Khám phá sắc màu<br/>
                    <span class="text-highlight">lễ hội Nhật Bản</span>
                </h1>
                <p class="hero-subtitle">
                    Hòa mình vào không khí sôi động của hàng trăm lễ hội truyền thống, 
                    từ hoa anh đào mùa xuân đến pháo hoa rực rỡ mùa hè.
                </p>
                
                <div class="hero-action-buttons">
                    <a href="/Festival" class="btn-premium btn-primary-glass">
                        Khám phá ngay <span class="arrow">→</span>
                    </a>
                    <a href="/Calendar" class="btn-premium btn-outline-glass">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        Lịch lễ hội
                    </a>
                </div>
            </div>

            <div class="hero-stats fade-up-anim" style="animation-delay: 0.2s;">
                <div class="stat-item glass-card">
                    <div class="stat-number">20+</div>
                    <div class="stat-label">Lễ hội nổi bật</div>
                </div>
                <div class="stat-item glass-card">
                    <div class="stat-number">4</div>
                    <div class="stat-label">Mùa lễ hội</div>
                </div>
                <div class="stat-item glass-card">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">Trải nghiệm thực</div>
                </div>
            </div>
        </div>
        
        <div class="scroll-indicator">
            <div class="mouse"></div>
            <span>Cuộn xuống</span>
        </div>
    </section>

    <!-- FOUR SEASONS SECTION -->
    <section class="section-padding bg-light-pattern">
        <div class="container">
            <div class="section-header text-center fade-up-anim" style="animation-delay: 0.1s;">
                <span class="section-accent">BỐN MÙA CẢM XÚC</span>
                <h2 class="section-title">Hành Trình Khám Phá Qua 4 Mùa</h2>
                <p class="section-desc mx-auto">Mỗi mùa tại Nhật Bản đều mang một sắc thái riêng biệt, tạo nên những lễ hội đặc trưng không thể nhầm lẫn.</p>
            </div>

            <div class="row g-4 mt-2">
                <!-- Spring -->
                <div class="col-lg-6 col-md-6">
                    <a href="/Festival?seasonId=1" class="season-bento-card fade-up-anim" style="animation-delay: 0.2s;">
                        <img src="@Url.Content("~/images/tokyo-hanami.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Mùa Xuân" class="season-bg" />
                        <div class="season-overlay"></div>
                        <div class="season-content">
                            <div class="season-icon-glass">🌸</div>
                            <div>
                                <h3 class="season-title">Mùa Xuân</h3>
                                <p class="season-desc">Hoa anh đào (Hanami), không khí nhẹ nhàng & lãng mạn.</p>
                            </div>
                        </div>
                    </a>
                </div>
                
                <!-- Summer -->
                <div class="col-lg-6 col-md-6">
                    <a href="/Festival?seasonId=2" class="season-bento-card fade-up-anim" style="animation-delay: 0.3s;">
                        <img src="@Url.Content("~/images/osaka-tenjin.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Mùa Hè" class="season-bg" />
                        <div class="season-overlay"></div>
                        <div class="season-content">
                            <div class="season-icon-glass">🎆</div>
                            <div>
                                <h3 class="season-title">Mùa Hè</h3>
                                <p class="season-desc">Lễ hội pháo hoa, diễu hành hoành tráng & nhảy điệu múa truyền thống.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Autumn -->
                <div class="col-lg-6 col-md-6">
                    <a href="/Festival?seasonId=3" class="season-bento-card fade-up-anim" style="animation-delay: 0.4s;">
                        <img src="@Url.Content("~/images/kyoto-jidai.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Mùa Thu" class="season-bg" />
                        <div class="season-overlay"></div>
                        <div class="season-content">
                            <div class="season-icon-glass">🍁</div>
                            <div>
                                <h3 class="season-title">Mùa Thu</h3>
                                <p class="season-desc">Sắc lá đỏ Momiji, không gian đền chùa trầm mặc & cổ kính.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Winter -->
                <div class="col-lg-6 col-md-6">
                    <a href="/Festival?seasonId=4" class="season-bento-card fade-up-anim" style="animation-delay: 0.5s;">
                        <img src="@Url.Content("~/images/sapporo-snow.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Mùa Đông" class="season-bg" />
                        <div class="season-overlay"></div>
                        <div class="season-content">
                            <div class="season-icon-glass">❄️</div>
                            <div>
                                <h3 class="season-title">Mùa Đông</h3>
                                <p class="season-desc">Lễ hội điêu khắc băng tuyết, ánh sáng lấp lánh lung linh.</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURED FESTIVALS -->
    <section class="section-padding bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div class="section-header mb-0">
                    <span class="section-accent">TIÊU BIỂU NHẤT</span>
                    <h2 class="section-title">Lễ Hội Nổi Bật</h2>
                </div>
                <a href="/Festival" class="view-all-link d-none d-md-flex">
                    Xem tất cả <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="premium-festival-card hover-lift">
                        <div class="card-img-wrapper">
                            <span class="location-badge">Kyoto</span>
                            <img src="@Url.Content("~/images/kyoto-gion.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Gion Matsuri" />
                        </div>
                        <div class="card-content">
                            <h3>Gion Matsuri</h3>
                            <p>Lễ hội truyền thống nổi tiếng nhất tại Kyoto với các cỗ xe rước khổng lồ được trang hoàng lộng lẫy.</p>
                            <a href="/Festival?keyword=Gion" class="explore-btn">Khám phá <span class="arrow">→</span></a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="premium-festival-card hover-lift" style="transition-delay: 0.1s">
                        <div class="card-img-wrapper">
                            <span class="location-badge">Tokyo</span>
                            <img src="@Url.Content("~/images/tokyo-hanami.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Hanami Ueno" />
                        </div>
                        <div class="card-content">
                            <h3>Hanami Ueno</h3>
                            <p>Tận hưởng không gian ngắm hoa anh đào mùa xuân rực rỡ nhất tại công viên Ueno, thủ đô Tokyo.</p>
                            <a href="/Festival?seasonId=1" class="explore-btn">Khám phá <span class="arrow">→</span></a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="premium-festival-card hover-lift" style="transition-delay: 0.2s">
                        <div class="card-img-wrapper">
                            <span class="location-badge">Hokkaido</span>
                            <img src="@Url.Content("~/images/sapporo-snow.jpg")" onerror="this.src='@Url.Content("~/images/default.jpg")';" alt="Sapporo Snow Festival" />
                        </div>
                        <div class="card-content">
                            <h3>Sapporo Snow Festival</h3>
                            <p>Chiêm ngưỡng hàng trăm tác phẩm điêu khắc băng tuyết khổng lồ và tinh xảo tại Hokkaido.</p>
                            <a href="/Festival?seasonId=4" class="explore-btn">Khám phá <span class="arrow">→</span></a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4 d-block d-md-none">
                <a href="/Festival" class="btn-premium btn-solid-dark w-100">Xem tất cả lễ hội</a>
            </div>
        </div>
    </section>

    <!-- TOOLS (MAP & CALENDAR) -->
    <section class="section-padding bg-light-pattern">
        <div class="container">
            <div class="row g-5 align-items-center mb-5">
                <div class="col-lg-6 order-lg-2">
                    <div class="tool-image-wrapper">
                        <div class="glass-floater top-left">📍 Xem toàn bộ vị trí</div>
                        <div class="glass-floater bottom-right">🗺️ Bản đồ Google Maps</div>
                        <img src="@Url.Content("~/images/kyoto-aoi1.jpg")" alt="Bản đồ Nhật Bản" class="main-tool-img shadow-lg" style="object-position: center; border-radius: 30px; height: 400px; width: 100%; object-fit: cover;" />
                    </div>
                </div>
                <div class="col-lg-6 order-lg-1 pe-lg-5">
                    <span class="section-accent">CÔNG CỤ TIỆN ÍCH</span>
                    <h2 class="section-title text-start mb-4">Bản Đồ Tương Tác Trực Quan</h2>
                    <p class="tool-desc mb-4">
                        Khám phá vị trí chính xác của từng lễ hội trên bản đồ toàn nước Nhật. 
                        Công cụ bản đồ tích hợp cho phép bạn dễ dàng lên kế hoạch di chuyển và tìm đường bằng Google Maps một cách nhanh chóng.
                    </p>
                    <a href="/Map" class="btn-premium btn-solid-primary">
                        Mở bản đồ ngay <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ms-2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </a>
                </div>
            </div>

            <div class="row g-5 align-items-center mt-4">
                <div class="col-lg-6">
                    <div class="tool-calendar-visual shadow-lg">
                        <div class="calendar-header">
                            <div class="dots"><span></span><span></span><span></span></div>
                            <div class="month-title">Tháng @DateTime.Today.ToString("MM"), @DateTime.Today.Year</div>
                        </div>
                        <div class="calendar-body">
                            <div class="day-names"><span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span></div>
                            <div class="days-grid">
                                <!-- Dummy grid for visual appeal -->
                                @for(int i=1; i<=28; i++) {
                                    <div class="day @(i == DateTime.Today.Day ? "active" : "") @(i == 15 || i == 22 ? "has-event" : "")">@i</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 ps-lg-5">
                    <span class="section-accent">LÊN KẾ HOẠCH</span>
                    <h2 class="section-title text-start mb-4">Lịch Trình Thông Minh</h2>
                    <p class="tool-desc mb-4">
                        Không bao giờ bỏ lỡ bất kỳ lễ hội nào. Lịch lễ hội tự động sắp xếp và hiển thị các sự kiện sắp diễn ra dựa trên thời gian thực, giúp bạn chuẩn bị tốt nhất cho chuyến đi của mình.
                    </p>
                    <a href="/Calendar" class="btn-premium btn-solid-dark">
                        Xem lịch trình <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ms-2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta-section">
        <div class="cta-overlay"></div>
        <div class="container position-relative z-index-1">
            <div class="text-center cta-content">
                <h2 class="cta-title">Bạn Đã Sẵn Sàng Khám Phá?</h2>
                <p class="cta-desc">Lưu lại các lễ hội yêu thích và chuẩn bị cho hành trình trải nghiệm văn hóa tuyệt vời tại Nhật Bản.</p>
                <div class="d-flex justify-content-center gap-3 mt-5 flex-wrap">
                    <a href="/Account/Register" class="btn-premium btn-solid-primary px-5">Tạo tài khoản ngay</a>
                    <a href="/Festival" class="btn-premium btn-outline-light px-5">Xem danh sách lễ hội</a>
                </div>
            </div>
        </div>
    </section>

</div>

<style>
    /* PREMIUM AESTHETIC - HOME PAGE */
    :root {
        --primary: #d90429;
        --primary-light: #ef233c;
        --dark: #1a1a24;
        --dark-muted: #2b2d42;
        --gray: #8d93a5;
        --light: #f8f9fc;
        --white: #ffffff;
    }

    .premium-home {
        margin: -30px; /* Overcome _Layout padding */
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    /* TYPOGRAPHY & UTILS */
    .section-padding { padding: 100px 0; }
    .bg-light-pattern { background-color: var(--light); }
    .bg-white { background-color: var(--white); }
    
    .section-accent {
        display: inline-block;
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 42px;
        font-weight: 800;
        color: var(--dark);
        margin-bottom: 20px;
        line-height: 1.2;
    }

    .section-desc {
        font-size: 18px;
        color: var(--gray);
        line-height: 1.6;
        max-width: 600px;
    }

    /* BUTTONS */
    .btn-premium {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 16px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-primary-glass {
        background: rgba(217, 4, 41, 0.85);
        backdrop-filter: blur(10px);
        color: white;
        border: 1px solid rgba(217, 4, 41, 0.4);
        box-shadow: 0 10px 30px rgba(217, 4, 41, 0.3);
    }
    .btn-primary-glass:hover {
        background: var(--primary);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(217, 4, 41, 0.4);
    }

    .btn-outline-glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .btn-outline-glass:hover {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        transform: translateY(-3px);
    }

    .btn-solid-primary {
        background: var(--primary);
        color: white;
        box-shadow: 0 10px 25px rgba(217, 4, 41, 0.25);
    }
    .btn-solid-primary:hover {
        background: var(--primary-light);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(217, 4, 41, 0.35);
    }

    .btn-solid-dark {
        background: var(--dark);
        color: white;
        box-shadow: 0 10px 25px rgba(26, 26, 36, 0.2);
    }
    .btn-solid-dark:hover {
        background: var(--dark-muted);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(26, 26, 36, 0.3);
    }

    .btn-outline-light {
        background: transparent;
        color: white;
        border: 2px solid white;
    }
    .btn-outline-light:hover {
        background: white;
        color: var(--dark);
        transform: translateY(-3px);
    }

    /* HERO SECTION */
    .hero-section {
        position: relative;
        height: 100vh;
        min-height: 700px;
        width: 100%;
        display: flex;
        align-items: center;
        overflow: hidden;
        margin-top: -72px; /* Overlap navbar */
        padding-top: 72px;
    }

    .hero-video {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover;
        z-index: 0;
        transform: scale(1.05);
        animation: heroSlowZoom 20s linear infinite alternate;
    }

    @@keyframes heroSlowZoom {
        from { transform: scale(1.05); }
        to { transform: scale(1.15); }
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(105deg, rgba(15,15,20,0.85) 0%, rgba(15,15,20,0.5) 50%, rgba(15,15,20,0.2) 100%);
        z-index: 1;
    }

    .hero-content-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 5%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 50px;
    }

    .hero-text-content { max-width: 650px; }

    .glass-badge {
        display: inline-block;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        padding: 8px 20px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .hero-main-title {
        font-size: 72px;
        font-weight: 900;
        color: white;
        line-height: 1.1;
        margin-bottom: 24px;
    }

    .text-highlight { color: var(--primary-light); }

    .hero-subtitle {
        font-size: 20px;
        color: rgba(255,255,255,0.8);
        line-height: 1.6;
        margin-bottom: 40px;
        font-weight: 400;
    }

    .hero-action-buttons {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .hero-action-buttons .arrow {
        transition: transform 0.3s;
        display: inline-block;
        margin-left: 8px;
    }
    .hero-action-buttons a:hover .arrow { transform: translateX(5px); }

    /* Hero Stats */
    .hero-stats {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .stat-item.glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 25px 35px;
        border-radius: 24px;
        min-width: 220px;
        text-align: center;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        transition: transform 0.3s;
    }
    .stat-item.glass-card:hover { transform: translateX(-10px); background: rgba(255, 255, 255, 0.1); }

    .stat-number {
        font-size: 36px;
        font-weight: 900;
        color: white;
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 14px;
        color: rgba(255,255,255,0.7);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    /* Scroll Indicator */
    .scroll-indicator {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: rgba(255,255,255,0.6);
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .mouse {
        width: 26px; height: 42px;
        border: 2px solid rgba(255,255,255,0.6);
        border-radius: 15px;
        position: relative;
        margin-bottom: 10px;
    }

    .mouse::before {
        content: '';
        position: absolute;
        top: 8px; left: 50%;
        transform: translateX(-50%);
        width: 4px; height: 8px;
        background: white;
        border-radius: 2px;
        animation: scrollWheel 2s infinite;
    }

    @@keyframes scrollWheel {
        0% { opacity: 1; transform: translate(-50%, 0); }
        100% { opacity: 0; transform: translate(-50%, 15px); }
    }

    /* FOUR SEASONS BENTO */
    .season-bento-card {
        display: block;
        position: relative;
        height: 320px;
        border-radius: 30px;
        overflow: hidden;
        text-decoration: none !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

    .season-bg {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .season-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15,15,20,0.9) 0%, rgba(15,15,20,0.2) 60%, transparent 100%);
        transition: opacity 0.5s;
    }

    .season-bento-card:hover .season-bg { transform: scale(1.1); }
    .season-bento-card:hover .season-overlay { opacity: 0.8; }

    .season-content {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        padding: 30px;
        display: flex;
        align-items: flex-end;
