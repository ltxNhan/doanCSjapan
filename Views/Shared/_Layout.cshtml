<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Japan Festival</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        html{
            scroll-behavior:smooth;
        }

        body{
            font-family:'Poppins',sans-serif;
            background:#f5f7fb;
            overflow-x:hidden;
        }

        /* ================= NAVBAR ================= */

        .main-navbar{
            width:100%;
            background:linear-gradient(90deg,#c1121f,#ef233c);
            position:sticky;
            top:0;
            z-index:9999;
            box-shadow:0 4px 20px rgba(0,0,0,.15);
        }

        .nav-wrapper{
            width:100%;
            min-height:72px;

            padding:0 30px;

            display:flex;
            align-items:center;
            justify-content:space-between;

            flex-wrap:wrap;
        }

        .brand-logo{
            color:white;
            text-decoration:none;
            font-size:28px;
            font-weight:800;
        }

        .main-menu{
            display:flex;
            align-items:center;
            gap:20px;
            flex-wrap:wrap;
        }

        .main-menu a{
            color:white;
            text-decoration:none;
            font-weight:600;
            transition:.3s;
        }

        .main-menu a:hover{
            transform:translateY(-2px);
            opacity:.9;
        }

        .account-box{
            display:flex;
            align-items:center;
            gap:12px;
        }

        .login-btn{
            background:white;
            color:#c1121f !important;
            text-decoration:none;
            padding:10px 20px;
            border-radius:999px;
            font-weight:700;
        }

        .user-badge{
            background:rgba(255,255,255,.2);
            color:white;
            padding:8px 16px;
            border-radius:999px;
            font-weight:600;
        }

        .logout-btn{
            color:white;
            text-decoration:none;
            border:1px solid rgba(255,255,255,.5);
            padding:8px 15px;
            border-radius:999px;
        }

        /* ================= PAGE ================= */

        .full-page{
            width:100%;
            min-height:100vh;
        }

        .normal-page{
            width:100%;
            padding:30px;
            min-height:100vh;
        }

        footer{
            background:#111;
            color:#ccc;
            text-align:center;
            padding:20px;
        }

        /* ================= ZALO FLOAT ================= */

        .zalo-support-wrapper{
            position:fixed;
            right:25px;
            bottom:25px;
            z-index:99999;
        }

        .zalo-float-button{
            width:65px;
            height:65px;

            border:none;
            border-radius:50%;

            background:white;

            box-shadow:0 10px 35px rgba(0,0,0,.25);

            cursor:pointer;

            overflow:hidden;

            transition:.3s;
        }

        .zalo-float-button:hover{
            transform:scale(1.08);
        }

        .zalo-float-button img{
            width:100%;
            height:100%;
            object-fit:cover;
        }

        .zalo-support-box{
            position:absolute;
            bottom:85px;
            right:0;

            width:330px;

            background:white;

            border-radius:20px;

            overflow:hidden;

            box-shadow:0 15px 40px rgba(0,0,0,.25);

            display:none;
        }

        .zalo-support-box.show{
            display:block;
        }

        .zalo-support-header{
            background:#e11d48;
            color:white;
            padding:16px;
            font-weight:700;

            display:flex;
            justify-content:space-between;
            align-items:center;
        }

        .zalo-close-btn{
            background:none;
            border:none;
            color:white;
            font-size:22px;
            cursor:pointer;
        }

        .zalo-support-body{
            padding:16px;
        }

        .zalo-support-text{
            margin-bottom:14px;
            color:#555;
        }

        .zalo-staff-item{
            display:flex;
            align-items:center;
            gap:12px;

            padding:14px;
            border-radius:14px;

            text-decoration:none;
            color:#222;

            transition:.3s;
        }

        .zalo-staff-item:hover{
            background:#f5f5f5;
        }

        .zalo-staff-avatar{
            width:45px;
            height:45px;

            border-radius:50%;

            background:#ef233c;
            color:white;

            display:flex;
            align-items:center;
            justify-content:center;

            font-weight:700;
        }

        .zalo-staff-info{
            display:flex;
            flex-direction:column;
        }

        /* ================= QR POPUP ================= */

        .qr-popup{
            position:fixed;
            top:0;
            left:0;
            right:0;
            bottom:0;

            background:rgba(0,0,0,.6);

            display:none;
            justify-content:center;
            align-items:center;

            z-index:999999;
        }

        .qr-popup.show{
            display:flex;
        }

        .qr-content{
            background:white;
            width:320px;

            border-radius:20px;

            padding:25px;

            text-align:center;

            position:relative;
        }

        .qr-content img{
            width:220px;
            margin-top:15px;
            border-radius:14px;
        }

        .qr-close{
            position:absolute;
            right:15px;
            top:10px;

            font-size:28px;
            cursor:pointer;
        }

        /* ================= MOBILE ================= */

        @@media(max-width:768px){

            .nav-wrapper{
                padding:15px;
                gap:15px;
                justify-content:center;
            }

            .main-menu{
                justify-content:center;
            }

            .normal-page{
                padding:15px;
            }

            .zalo-support-box{
                width:300px;
            }

        }

    </style>

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="main-navbar">

        <div class="nav-wrapper">

            <a href="/Home" class="brand-logo">
                🎌 Japan Festival
            </a>

            <div class="main-menu">

                <a href="/Home">🏠 Trang chủ</a>

                <a href="/Festival">🎎 Lễ hội</a>

                @if (Context.Session.GetString("Username") != null)
                {
                    <a href="/Favorite">❤️ Theo dõi</a>
                    <a href="/Map">🗺️ Bản đồ</a>
                    <a href="/Quiz">🧠 Quiz</a>
                }

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a href="/Festival/Create">➕ Quản lý lễ hội</a>
                    <a href="/Quiz/Admin">❓ Quản lý Quiz</a>
                }

            </div>

            <div class="account-box">

                @if (Context.Session.GetString("Username") == null)
                {
                    <a href="/Account/Login" class="login-btn">
                        🔑 Login
                    </a>
                }
                else
                {
                    <div class="user-badge">
                        👤 @Context.Session.GetString("Username")
                        (@Context.Session.GetString("Role"))
                    </div>

                    <a href="/Account/Logout" class="logout-btn">
                        Logout
                    </a>
                }

            </div>

        </div>

    </nav>

    <!-- ================= BODY ================= -->

    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    @if (controller == "Home")
    {
        <div class="full-page">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="normal-page">
            @RenderBody()
        </div>
    }

    <!-- ================= FOOTER ================= -->

    <footer>
        © 2026 Japan Festival - Khám phá văn hóa Nhật Bản
    </footer>

    <!-- ================= ZALO ================= -->

    <div class="zalo-support-wrapper">

        <!-- BOX -->

        <div class="zalo-support-box" id="zaloSupportBox">

            <div class="zalo-support-header">

                <span>Hỗ trợ qua Zalo</span>

                <button type="button"
                        class="zalo-close-btn"
                        onclick="toggleZaloBox()">
                    ×
                </button>

            </div>

            <div class="zalo-support-body">

                <p class="zalo-support-text">
                    Chọn nhân viên hỗ trợ:
                </p>

                <!-- PERSON 1 -->

                <a href="#"
                   class="zalo-staff-item"
                   onclick="openQR(event,'nhan')">

                    <div class="zalo-staff-avatar">A</div>

                    <div class="zalo-staff-info">
                        <strong>Xuân Nhạn</strong>
                        <span>Tư vấn lễ hội</span>
                    </div>

                </a>

                <!-- PERSON 2 -->

                <a href="#"
                   class="zalo-staff-item"
                   onclick="openQR(event,'binh')">

                    <div class="zalo-staff-avatar">B</div>

                    <div class="zalo-staff-info">
                        <strong>Trần Bình</strong>
                        <span>Hỗ trợ vé máy bay</span>
                    </div>

                </a>

                <!-- PERSON 3 -->

                <a href="#"
                   class="zalo-staff-item"
                   onclick="openQR(event,'nha')">

                    <div class="zalo-staff-avatar">C</div>

                    <div class="zalo-staff-info">
                        <strong>Đức Nhã</strong>
                        <span>Hỗ trợ khách sạn</span>
                    </div>

                </a>

            </div>

        </div>

        <!-- FLOAT BUTTON -->

        <button type="button"
                class="zalo-float-button"
                onclick="toggleZaloBox()">

            <img src="/images/zalo-icon.png" />

        </button>

    </div>

    <!-- ================= QR POPUP ================= -->

    <div class="qr-popup" id="qrPopup">

        <div class="qr-content">

            <span class="qr-close"
                  onclick="closeQR()">
                ×
            </span>

            <h4>Quét mã QR để liên hệ</h4>

            <img id="qrImage"
                 src="/images/qr-default.png" />

            <a id="qrLink"
               href="#"
               target="_blank"
               class="btn btn-danger mt-3">

                Chat trực tiếp

            </a>

        </div>

    </div>

    <!-- ================= JS ================= -->

    <script>

        function toggleZaloBox(){

            document
                .getElementById("zaloSupportBox")
                .classList
                .toggle("show");

        }

        function openQR(event,staff){

            event.preventDefault();

            const popup = document.getElementById("qrPopup");
            const img = document.getElementById("qrImage");
            const link = document.getElementById("qrLink");

            if(staff==="nhan"){

                img.src="/images/qr-nhan.jpg";
                link.href="https://chat.zalo.me/";

            }
            else if(staff==="binh"){

                img.src="/images/qr-binh.jpg";
                link.href="https://chat.zalo.me/";

            }
            else if(staff==="nha"){

                img.src="/images/qr-nha.jpg";
                link.href="https://chat.zalo.me/";

            }

            popup.classList.add("show");

        }

        function closeQR(){

            document
                .getElementById("qrPopup")
                .classList
                .remove("show");

        }

        document
            .getElementById("qrPopup")
            .addEventListener("click",function(e){

                if(e.target===this){

                    closeQR();

                }

            });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>