</style>

<script>
    let festivalMap;
    let festivalMarker;

    const festivalLatitude = @Model.Latitude;
    const festivalLongitude = @Model.Longitude;
    const festivalName = "@Model.Name";
    const festivalLocation = "@Model.LocationName";

    function initFestivalMap() {
        let lat = festivalLatitude;
        let lng = festivalLongitude;

        if (lat === 0 || lng === 0) {
            lat = 36.2048;
            lng = 138.2529;
        }

        festivalMap = L.map('festivalMap').setView([lat, lng], 6);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(festivalMap);

        if (festivalLatitude !== 0 && festivalLongitude !== 0) {
            festivalMarker = L.marker([festivalLatitude, festivalLongitude])
                .addTo(festivalMap)
                .bindPopup("<b>" + festivalName + "</b><br>" + festivalLocation);
        }
    }

    function showFestivalMap() {
        document.getElementById("mapSection").scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        setTimeout(function () {
            if (festivalLatitude !== 0 && festivalLongitude !== 0) {
                festivalMap.setView([festivalLatitude, festivalLongitude], 14);
                festivalMarker.openPopup();
            } else {
                festivalMap.setView([36.2048, 138.2529], 5);
                alert("Lễ hội này chưa có tọa độ bản đồ. Hãy thêm Latitude và Longitude trong database.");
            }

            festivalMap.invalidateSize();
        }, 500);
    }

    document.addEventListener("DOMContentLoaded", function () {
        initFestivalMap();
    });
</script>

<script>
    const calendarStartDate = new Date("@GetDisplayStartDate(Model.StartDate, Model.EndDate).ToString("yyyy-MM-dd")T00:00:00");
    const calendarEndDate = new Date("@GetDisplayEndDate(Model.StartDate, Model.EndDate).ToString("yyyy-MM-dd")T00:00:00");

    function openFestivalCalendar() {
        document.getElementById("calendarModal").classList.add("show");
        renderFestivalCalendar();
    }

    function closeFestivalCalendar() {
        document.getElementById("calendarModal").classList.remove("show");
    }

    function renderFestivalCalendar() {
        const monthTitle = document.getElementById("calendarMonthTitle");
        const calendarDays = document.getElementById("calendarDays");

        calendarDays.innerHTML = "";

        const year = calendarStartDate.getFullYear();
        const month = calendarStartDate.getMonth();

        const monthNames = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];

        monthTitle.innerText = monthNames[month] + " " + year;

        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);

        const startWeekDay = firstDay.getDay();
        const totalDays = lastDay.getDate();

        for (let i = 0; i < startWeekDay; i++) {
            const empty = document.createElement("div");
            empty.className = "calendar-day empty";
            calendarDays.appendChild(empty);
        }

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let day = 1; day <= totalDays; day++) {
            const currentDate = new Date(year, month, day);
            currentDate.setHours(0, 0, 0, 0);

            const dayBox = document.createElement("div");
            dayBox.className = "calendar-day";
            dayBox.innerText = day;

            if (currentDate >= calendarStartDate && currentDate <= calendarEndDate) {
                dayBox.classList.add("active");
            }

            if (currentDate.getTime() === today.getTime()) {
                dayBox.classList.add("today");
            }

            calendarDays.appendChild(dayBox);
        }
    }

    window.addEventListener("click", function (event) {
        const modal = document.getElementById("calendarModal");

        if (event.target === modal) {
            closeFestivalCalendar();
        }
    });
</script>

@functions {
    public DateTime GetDisplayStartDate(DateTime startDate, DateTime endDate)
    {
        var today = DateTime.Today;

        var displayStart = new DateTime(today.Year, startDate.Month, startDate.Day);
        var displayEnd = new DateTime(today.Year, endDate.Month, endDate.Day);

        if (displayEnd < today)
        {
            displayStart = new DateTime(today.Year + 1, startDate.Month, startDate.Day);
        }

        return displayStart;
    }

    public DateTime GetDisplayEndDate(DateTime startDate, DateTime endDate)
    {
        var today = DateTime.Today;

        var displayEnd = new DateTime(today.Year, endDate.Month, endDate.Day);

        if (displayEnd < today)
        {
            displayEnd = new DateTime(today.Year + 1, endDate.Month, endDate.Day);
        }

        return displayEnd;
    }

    public string GetUpcomingStartDate(DateTime startDate, DateTime endDate)
    {
        return GetDisplayStartDate(startDate, endDate).ToString("dd/MM/yyyy");
    }

    public string GetUpcomingEndDate(DateTime startDate, DateTime endDate)
    {
        return GetDisplayEndDate(startDate, endDate).ToString("dd/MM/yyyy");
    }

    public string GetImageName(string name)
    {
        name = (name ?? "").ToLower();

        if (name.Contains("hanami")) return "tokyo-hanami.jpg";
        if (name.Contains("sumida")) return "tokyo-sumida.jpg";
        if (name.Contains("kanda")) return "tokyo-kanda.jpg";
        if (name.Contains("asakusa")) return "tokyo-asakusa.jpg";

        if (name.Contains("gion")) return "kyoto-gion.jpg";
        if (name.Contains("aoi")) return "kyoto-aoi1.jpg";
        if (name.Contains("jidai")) return "kyoto-jidai.jpg";

        if (name.Contains("tenjin")) return "osaka-tenjin.jpg";
        if (name.Contains("sumiyoshi")) return "osaka-sumiyoshi.jpg";

        if (name.Contains("snow")) return "sapporo-snow.jpg";
        if (name.Contains("yosakoi")) return "sapporo-yosakoi.jpg";

        if (name.Contains("hakata")) return "fukuoka-hakata.jpg";
        if (name.Contains("lantern")) return "nagasaki-lantern.jpg";

        if (name.Contains("takayama")) return "takayama.jpg";
        if (name.Contains("fuji")) return "fuji.jpg";

        if (name.Contains("akita")) return "akita.jpg";
        if (name.Contains("nebuta")) return "nebuta.jpg";
        if (name.Contains("sendai")) return "sendai.jpg";
        if (name.Contains("okinawa")) return "okinawa.jpg";
        if (name.Contains("kumamoto")) return "kumamoto.jpg";
        if (name.Contains("nagoya")) return "nagoya.jpg";
        if (name.Contains("kanazawa")) return "kanazawa.jpg";
        if (name.Contains("kobe")) return "kobe.jpg";
        if (name.Contains("nara")) return "nara.jpg";
        if (name.Contains("chichibu")) return "chichibu.jpg";
        if (name.Contains("kawagoe")) return "kawagoe.jpg";

        return "default.jpg";
    }
}