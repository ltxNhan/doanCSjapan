        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .festival-title {
            font-size: 30px;
        }

        .detail-image-wrap {
            height: 260px;
        }

        .map-header {
            flex-direction: column;
            align-items: flex-start;
        }

        #festivalMap {
            height: 320px;
        }

        .calendar-date-info {
            grid-template-columns: 1fr;
        }

        .calendar-day {
            height: 38px;
            border-radius: 10px;
        }
