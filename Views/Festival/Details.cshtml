@model JapanApp.Models.Festival

@{
    ViewData["Title"] = Model.Name;
}

<div class="festival-detail-page">

    <!-- BACK BUTTON -->
    <div class="mb-4">
        <a href="/Festival" class="btn btn-outline-secondary rounded-pill px-4">
            ← Back to Festivals
        </a>
    </div>

    <!-- HERO DETAIL CARD -->
    <div class="detail-card shadow-lg">

        <!-- IMAGE -->
        <div class="detail-image-wrap">
            <img src="@Url.Content("~/images/" + GetImageName(Model.Name))"
                 onerror="this.onerror=null; this.src='@Url.Content("~/images/default.jpg")';"
                 alt="@Model.Name"
                 class="detail-image" />

            <div class="image-overlay">
                <span class="badge bg-danger px-3 py-2">Festival</span>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="detail-content">

            <h1 class="festival-title">@Model.Name</h1>

            <p class="festival-subtitle">
                Discover one of Japan's most beautiful traditional festivals.
            </p>

            <div class="info-grid">

                <!-- LOCATION CLICK -->
                <div class="info-box location-click" onclick="showFestivalMap()">
                    <div class="info-icon">📍</div>
                    <div>
                        <small>Location</small>
                        <strong>@Model.LocationName</strong>
                        <span class="map-hint">Click to view on map</span>
                    </div>
                </div>

                <div class="info-box">
                    <div class="info-icon">📅</div>
                    <div>
                        <small>Start Date</small>
                        <strong>@GetUpcomingStartDate(Model.StartDate, Model.EndDate)</strong>
                    </div>
                </div>

                <div class="info-box">
                    <div class="info-icon">🏁</div>
                    <div>
                        <small>End Date</small>
                        <strong>@GetUpcomingEndDate(Model.StartDate, Model.EndDate)</strong>
                    </div>
                </div>

                @if (Model.Region != null)
                {
                    <div class="info-box">
                        <div class="info-icon">🗾</div>
                        <div>
                            <small>Region</small>
                            <strong>@Model.Region.RegionName</strong>
                        </div>
                    </div>
                }

                @if (Model.Season != null)
                {
                    <div class="info-box">
                        <div class="info-icon">🌸</div>
                        <div>
                            <small>Season</small>
                            <strong>@Model.Season.SeasonName</strong>
                        </div>
                    </div>
                }

            </div>

            <hr class="my-4" />

            <div class="section-block">
                <h3>About this festival</h3>

                <p>
                    @Model.Content
                </p>
            </div>

            <!-- MAP SECTION -->
            <div id="mapSection" class="map-section">
                <div class="map-header">
                    <div>
                        <h3>Location on Japan Map</h3>
                        <p>@Model.Name - @Model.LocationName</p>
                    </div>

                    <span class="map-badge">OpenStreetMap API</span>
                </div>

                <div id="festivalMap"></div>
            </div>

            <div class="action-area">
                <button type="button" class="btn btn-primary rounded-pill px-4 py-2" onclick="openFestivalCalendar()">
                    📅 View Calendar
                </button>

                <a href="/Festival/AddFavorite/@Model.FestivalID" class="btn btn-danger rounded-pill px-4 py-2">
                    ❤️ Add to Favorite
                </a>

                <a href="/Festival" class="btn btn-light border rounded-pill px-4 py-2">
                    View More Festivals
                </a>
            </div>

        </div>
    </div>
</div>

<!-- CALENDAR MODAL -->
<div id="calendarModal" class="calendar-modal">
    <div class="calendar-box">
        <div class="calendar-header">
            <div>
                <h3>Festival Calendar</h3>
                <p>@Model.Name</p>
            </div>

            <button type="button" class="calendar-close" onclick="closeFestivalCalendar()">×</button>
        </div>

        <div class="calendar-date-info">
            <div>
                <small>Start Date</small>
                <strong>@GetUpcomingStartDate(Model.StartDate, Model.EndDate)</strong>
            </div>

            <div>
                <small>End Date</small>
                <strong>@GetUpcomingEndDate(Model.StartDate, Model.EndDate)</strong>
            </div>
        </div>

        <div class="calendar-month-title" id="calendarMonthTitle"></div>

        <div class="calendar-weekdays">
            <span>Sun</span>
            <span>Mon</span>
            <span>Tue</span>
            <span>Wed</span>
            <span>Thu</span>
            <span>Fri</span>
            <span>Sat</span>
        </div>

        <div id="calendarDays" class="calendar-days"></div>

        <div class="calendar-note">
            <span class="legend-active"></span>
            Festival date range
        </div>
    </div>
</div>

<!-- LEAFLET MAP API -->
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .festival-detail-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px 15px 60px;
    }

    .detail-card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.06);
    }

    .detail-image-wrap {
        position: relative;
        width: 100%;
        height: 430px;
        overflow: hidden;
        background: #f5f5f5;
    }

    .detail-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .image-overlay {
        position: absolute;
        left: 28px;
        bottom: 24px;
    }

    .detail-content {
        padding: 38px 44px 44px;
    }

    .festival-title {
        font-size: 42px;
        font-weight: 800;
        color: #222;
        margin-bottom: 10px;
    }

    .festival-subtitle {
        font-size: 18px;
        color: #777;
        margin-bottom: 28px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .info-box {
        display: flex;
        gap: 14px;
        align-items: center;
        background: #fafafa;
        border: 1px solid #eee;
        border-radius: 18px;
        padding: 18px;
    }

    .info-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #fff0f2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .info-box small {
        display: block;
        color: #888;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .info-box strong {
        display: block;
        color: #222;
        font-size: 16px;
    }

    .location-click {
        cursor: pointer;
        transition: 0.25s;
    }

        .location-click:hover {
            background: #fff0f2;
            border-color: #ef3b4d;
            transform: translateY(-3px);
        }

    .map-hint {
        display: block;
        font-size: 12px;
        color: #ef3b4d;
        margin-top: 4px;
    }

    .section-block h3 {
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 14px;
        color: #222;
    }

    .section-block p {
        font-size: 18px;
        line-height: 1.8;
        color: #555;
        margin-bottom: 0;
    }

    .map-section {
        margin-top: 40px;
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid #eee;
        padding: 24px;
    }

    .map-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
        margin-bottom: 18px;
    }

        .map-header h3 {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 5px;
            color: #222;
        }

        .map-header p {
            color: #777;
            margin-bottom: 0;
        }

    .map-badge {
        background: #fff0f2;
        color: #ef3b4d;
        border: 1px solid #ffd1d8;
        padding: 8px 14px;
        border-radius: 999px;
