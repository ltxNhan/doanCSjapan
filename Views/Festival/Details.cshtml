    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 20px;
    }

        .calendar-header h3 {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 4px;
            color: #222;
        }

        .calendar-header p {
            margin-bottom: 0;
            color: #777;
        }

    .calendar-close {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: #f4f4f4;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
    }

