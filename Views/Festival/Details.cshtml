            background: #ffe1e6;
            color: #ef3b4d;
        }

    .calendar-date-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 22px;
    }

        .calendar-date-info div {
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 16px;
            padding: 16px;
        }

        .calendar-date-info small {
            display: block;
            color: #888;
            margin-bottom: 4px;
        }

        .calendar-date-info strong {
